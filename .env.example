# Never commit real credentials. Demo works without any credentials.
GITHUB_TOKEN=
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Real-model calls require explicit, current prices in USD per 1M tokens.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
# Both an explicit CLI flag AND this variable are required to publish.
ALLOW_GITHUB_COMMENTS=false
